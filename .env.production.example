# Copiez ce fichier en .env.production puis remplissez de vraies valeurs.
# Ne jamais committer .env.production (déjà exclu par .gitignore).

POSTGRES_USER=csp_prod
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=csp_prodiges

# Générez avec : openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Sous-domaines nip.io (gratuits, résolvent directement vers l'IP du VPS —
# aucun domaine à acheter) routés par sef-nginx en HTTP simple (pas de TLS
# pour l'instant, c'est une version de test).
SITE_DOMAIN=csp.79.137.54.238.nip.io
INTRANET_DOMAIN=intranet-csp.79.137.54.238.nip.io

CORS_ORIGINS=http://csp.79.137.54.238.nip.io,http://intranet-csp.79.137.54.238.nip.io

# Version de test : seed de démo activé (comme en local), comptes de démo
# utilisables tels quels (voir README). À repasser à false avant un vrai lancement.
ENABLE_DEMO_SEED=true

# Ignorés tant qu'ENABLE_DEMO_SEED=true. Utile le jour où vous voudrez un vrai
# premier compte admin sans les comptes de démo (voir README).
ADMIN_EMAIL=admin@cite-scolaire-prodiges.org
ADMIN_PASSWORD=change-me-generate-a-strong-password
