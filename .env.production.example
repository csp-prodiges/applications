# Copiez ce fichier en .env.production puis remplissez de vraies valeurs.
# Ne jamais committer .env.production (déjà exclu par .gitignore).

POSTGRES_USER=csp_prod
POSTGRES_PASSWORD=change-me-generate-a-strong-password
POSTGRES_DB=csp_prodiges

# Générez avec : openssl rand -base64 48
JWT_SECRET=change-me-generate-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Origines autorisées à appeler l'API (site vitrine + intranet, ports publics)
CORS_ORIGINS=http://79.137.54.238:8084,http://79.137.54.238:8085

# Utilisée par docker-compose.prod.yml pour construire les liens croisés
# site <-> intranet au moment du build des frontends.
PUBLIC_IP=79.137.54.238

# IMPORTANT : les comptes de démo (admin/prof/famille Kouassi avec mots de passe
# connus, publiés dans le code sur GitHub) ne doivent PAS exister en production.
ENABLE_DEMO_SEED=false

# Créé automatiquement au premier démarrage si absent (seul moyen d'obtenir un
# premier compte admin quand ENABLE_DEMO_SEED=false). Changez le mot de passe
# depuis l'intranet ensuite, ou changez ces valeurs et redémarrez le backend.
ADMIN_EMAIL=admin@cite-scolaire-prodiges.org
ADMIN_PASSWORD=change-me-generate-a-strong-password
